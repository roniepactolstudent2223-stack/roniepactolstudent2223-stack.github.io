---
import BaseLayout from '../../layouts/BaseLayout.astro';

const certificates = [
	{
		title: 'Learn Vue',
		kind: 'Scrimba course certificate',
		fileType: 'PDF',
		id: '1wonwybKHHVxVuigyX6Dlzreh3dbWpqds',
		fileName: 'Learn Vue.pdf',
		issuer: 'Scrimba',
		date: '7 July 2026',
	},
	{
		title: 'English for IT 1',
		kind: 'Course certificate',
		fileType: 'PDF',
		id: '1txEvQ3kgye36pLv6A58inO6o5unFtcZu',
		fileName: 'English_for_IT_1_certificate.pdf',
	},
	{
		title: 'JavaScript Essentials 1',
		kind: 'Course certificate',
		fileType: 'PDF',
		id: '16fp94t9iPf2Gm1tvIFKdSxiLXXjhlg5K',
		fileName: 'JavaScript_Essentials_1_certificate.pdf',
	},
	{
		title: 'NC II',
		kind: 'National certificate',
		fileType: 'PDF',
		id: '1YevexiLOCXzNXxMxlOcuZHr0-TJk6OU6',
		fileName: 'NC2.pdf',
	},
	{
		title: 'On-the-job training',
		kind: 'Certificate of completion',
		fileType: 'PNG',
		id: '1YUwoyu9U40CPYeCVRfiQ77TVZiZRcgKM',
		fileName: 'OJT coc.png',
	},
	{
		title: 'Python Essentials 1',
		kind: 'Course certificate',
		fileType: 'PDF',
		id: '1nAj-2Ez9A_goIH__mZkUyGWJ_QPjXRos',
		fileName: 'Python_Essentials_1_certificate.pdf',
	},
];

const driveUrl = (id: string) => `https://drive.google.com/file/d/${id}/view?usp=sharing`;
const thumbnailUrl = (id: string) => `https://drive.google.com/thumbnail?id=${id}&sz=w1600`;
---

<BaseLayout title="Certificates — Ronie Pactol" description="Certificates and completed learning milestones from Ronie Pactol.">
	<div class="page-shell certificates-page">
		<header class="certificates-hero" aria-labelledby="certificates-title">
			<div>
				<p class="certificates-kicker">Learning record <span aria-hidden="true">/</span> {String(certificates.length).padStart(2, '0')} documents</p>
				<h1 id="certificates-title">Certificates<span>.</span></h1>
			</div>
			<p class="certificates-intro">A small archive of formal learning milestones that support my work across software, systems, and service.</p>
		</header>

		<section class="certificate-shelf" aria-labelledby="certificate-shelf-title">
			<div class="shelf-heading">
				<div>
					<p class="section-kicker">Certificate archive</p>
					<h2 id="certificate-shelf-title">Courses &amp; credentials</h2>
				</div>
				<p>{certificates.length} certificates · Google Drive originals</p>
			</div>

			<div class="certificate-grid">
				{certificates.map((certificate, index) => (
					<article class="certificate-card" aria-labelledby={`certificate-${index}-title`}>
						<a class="certificate-preview" href={driveUrl(certificate.id)} target="_blank" rel="noopener noreferrer" aria-label={`Open ${certificate.title} certificate in Google Drive (new tab)`}>
							<img data-certificate-preview src={thumbnailUrl(certificate.id)} alt={`Preview of ${certificate.title} certificate`} width="1600" height="1200" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
							<span class="preview-fallback" hidden>Preview unavailable<span>Open the original in Google Drive <span aria-hidden="true">↗</span></span></span>
						</a>
						<div class="certificate-copy">
							<p class="certificate-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
							<div class="certificate-details">
								<h3 id={`certificate-${index}-title`}>{certificate.title}</h3>
								<p class="certificate-kind">{certificate.kind} · {certificate.fileType}</p>
								{certificate.issuer && <p class="certificate-meta">{certificate.issuer} · Completed <time datetime="2026-07-07">{certificate.date}</time></p>}
								<a class="certificate-link" href={driveUrl(certificate.id)} target="_blank" rel="noopener noreferrer" aria-label={`Open ${certificate.title} certificate in Google Drive (new tab)`}>Open certificate <span aria-hidden="true">↗</span></a>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<aside class="certificate-note">
			<strong>Original files</strong>
			<p>Open a certificate in Google Drive to read, print, or download the full document.</p>
		</aside>
	</div>
</BaseLayout>

<style>
	.certificates-page { padding-block: 0 3rem; }
	.certificates-hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: end; gap: 2rem 4rem; padding-block: 2.25rem 2.5rem; border-bottom: 1px solid var(--color-ink); }
	.certificates-kicker, .section-kicker { margin: 0 0 0.8rem; color: var(--color-olive); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; }
	.certificates-kicker span { margin-inline: 0.35rem; color: var(--color-border); }
	h1 { margin: 0; font-size: clamp(2.25rem, 4vw, 3.5rem); letter-spacing: -0.055em; line-height: 1.05; }
	h1 span { color: var(--color-accent); }
	.certificates-intro { max-width: 34ch; margin: 0; color: var(--color-muted); font-size: 1rem; line-height: 1.7; }
	.certificate-shelf { padding-top: 2rem; }
	.shelf-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.25rem; }
	.shelf-heading .section-kicker { margin-bottom: 0.45rem; }
	h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.1; }
	.shelf-heading > p { margin: 0; color: var(--color-muted); font-size: 0.75rem; }
	.certificate-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
	.certificate-card { min-width: 0; border-top: 1px solid var(--color-ink); }
	.certificate-preview { display: block; position: relative; aspect-ratio: 4 / 3; margin-top: 0.75rem; border: 1px solid var(--color-border); background: var(--color-paper); }
	.certificate-preview img { display: block; width: 100%; height: 100%; object-fit: contain; }
	.certificate-preview img[hidden], .preview-fallback[hidden] { display: none; }
	.preview-fallback { display: grid; place-content: center; height: 100%; gap: 0.5rem; padding: 1rem; color: var(--color-muted); font-size: 0.9rem; text-align: center; }
	.preview-fallback > span { font-size: 0.75rem; text-decoration: underline; text-underline-offset: 0.25em; }
	.certificate-copy { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); column-gap: 0.5rem; align-content: start; padding-block: 1rem; }
	.certificate-number { margin: 0; color: var(--color-olive); font: 0.75rem/1.6 Consolas, monospace; }
	.certificate-details { min-width: 0; }
	h3 { margin: 0; font-size: 1.25rem; line-height: 1.15; }
	.certificate-kind { margin: 0.35rem 0 0; color: var(--color-muted); font-size: 0.75rem; line-height: 1.5; }
	.certificate-meta { margin: 0.55rem 0 0; color: var(--color-muted); font-size: 0.7rem; line-height: 1.5; }
	.certificate-link { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; margin-top: 0.65rem; font-size: 0.75rem; text-decoration: underline; text-underline-offset: 0.25em; }
	.certificate-note { display: flex; gap: 1rem; margin-top: 2rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border); font-size: 0.75rem; line-height: 1.6; }
	.certificate-note strong { flex: none; }
	.certificate-note p { max-width: 48ch; margin: 0; color: var(--color-muted); }
	@media (max-width: 900px) {
		.certificates-hero { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
	}
	@media (max-width: 640px) {
		.certificates-page { padding-bottom: 2rem; }
		.certificates-hero { gap: 0.85rem; padding-block: 1.25rem 1.5rem; }
		h1 { font-size: var(--mobile-title); }
		.certificates-intro { font-size: var(--mobile-body); line-height: 1.65; }
		.certificate-shelf { padding-top: 1.5rem; }
		.shelf-heading { display: block; margin-bottom: 1rem; }
		.shelf-heading > p { margin-top: 0.5rem; }
		.certificate-grid { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
		.certificate-copy { padding-block: 0.85rem; }
		.certificate-note { display: block; }
		.certificate-note p { margin-top: 0.35rem; }
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLImageElement>('[data-certificate-preview]').forEach(image => {
			const showFallback = () => {
				image.hidden = true;
				const fallback = image.nextElementSibling;
				if (fallback instanceof HTMLElement) fallback.hidden = false;
			};
			if (image.complete && !image.naturalWidth) showFallback();
			else image.addEventListener('error', showFallback, { once: true });
		});
	});
</script>
