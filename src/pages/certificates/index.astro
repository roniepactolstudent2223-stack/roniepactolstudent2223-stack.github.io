---
import BaseLayout from '../../layouts/BaseLayout.astro';

const certificates = [
	{
		title: 'Learn Vue',
		kind: 'Scrimba course certificate',
		fileType: 'PDF',
		id: '1wonwybKHHVxVuigyX6Dlzreh3dbWpqds',
		fileName: 'Learn Vue.pdf',
		issuer: 'Scrimba',
		date: '7 July 2026',
	},
	{
		title: 'English for IT 1',
		kind: 'Course certificate',
		fileType: 'PDF',
		id: '1txEvQ3kgye36pLv6A58inO6o5unFtcZu',
		fileName: 'English_for_IT_1_certificate.pdf',
	},
	{
		title: 'JavaScript Essentials 1',
		kind: 'Course certificate',
		fileType: 'PDF',
		id: '16fp94t9iPf2Gm1tvIFKdSxiLXXjhlg5K',
		fileName: 'JavaScript_Essentials_1_certificate.pdf',
	},
	{
		title: 'NC II',
		category: 'credential',
		kind: 'National certificate',
		fileType: 'PDF',
		id: '1YevexiLOCXzNXxMxlOcuZHr0-TJk6OU6',
		fileName: 'NC2.pdf',
	},
	{
		title: 'On-the-job training',
		category: 'credential',
		kind: 'Certificate of completion',
		fileType: 'PNG',
		id: '1YUwoyu9U40CPYeCVRfiQ77TVZiZRcgKM',
		fileName: 'OJT coc.png',
	},
	{
		title: 'Python Essentials 1',
		kind: 'Course certificate',
		fileType: 'PDF',
		id: '1nAj-2Ez9A_goIH__mZkUyGWJ_QPjXRos',
		fileName: 'Python_Essentials_1_certificate.pdf',
	},
];
const groups = [
	{ id: 'courses', title: 'Course certificates', items: certificates.filter(item => !item.category) },
	{ id: 'credentials', title: 'Training & qualifications', items: certificates.filter(item => item.category === 'credential') },
];

const driveUrl = (id: string) => `https://drive.google.com/file/d/${id}/view?usp=sharing`;
const thumbnailUrl = (id: string) => `https://drive.google.com/thumbnail?id=${id}&sz=w1600`;
---

<BaseLayout title="Certificates — Ronie Pactol" description="Certificates and completed learning milestones from Ronie Pactol.">
	<div class="page-shell certificates-page">
		<header class="certificates-hero" aria-labelledby="certificates-title">
			<h1 id="certificates-title">Certificates<span>.</span></h1>
			<p class="certificates-intro">Open a certificate in Google Drive to read, print, or download it.</p>
		</header>

		<div class="certificate-register">
			{groups.map(group => (
				<section class="certificate-group" aria-labelledby={`${group.id}-title`}>
					<h2 id={`${group.id}-title`}>{group.title}</h2>
					<ul class="certificate-list">
						{group.items.map(certificate => (
							<li>
								<a class="certificate-entry" href={driveUrl(certificate.id)} target="_blank" rel="noopener noreferrer" aria-labelledby={`title-${certificate.id} action-${certificate.id}`}>
									<div class="certificate-copy">
										<p class="document-type field-label">{certificate.fileType}</p>
										<h3 id={`title-${certificate.id}`}>{certificate.title}</h3>
										<p class="certificate-meta">{certificate.issuer ?? certificate.kind}{certificate.date && <> · <time datetime="2026-07-07">{certificate.date}</time></>}</p>
										<span class="certificate-action" id={`action-${certificate.id}`}>Open in Drive <span aria-hidden="true">↗</span><span class="sr-only"> (new tab)</span></span>
									</div>
									<div class="certificate-preview">
										<img data-certificate-preview src={thumbnailUrl(certificate.id)} alt={`Preview of ${certificate.title} certificate`} width="1600" height="1200" loading="lazy" decoding="async" />
										<span class="preview-fallback" hidden>Preview unavailable</span>
									</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>

	</div>
</BaseLayout>

<style>
	.certificates-page { padding-block: 0 3rem; }
	.certificates-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); align-items: end; gap: 1rem 2rem; padding: clamp(1rem, 3vw, 2rem); background: var(--color-sage); }
	h1 { letter-spacing: -0.035em; line-height: 1.05; }
	h1 span { color: var(--color-accent); }
	.certificates-intro { max-width: 36ch; margin: 0; color: var(--color-muted); font-size: var(--text-body); line-height: var(--line-body); }
	.certificate-register { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; gap: clamp(1.5rem, 4vw, 2.75rem); padding-top: 1.75rem; }
	h2 { margin: 0 0 0.85rem; font-size: var(--text-section); line-height: 1.1; }
	.certificate-list { list-style: none; margin: 0; padding: 0; }
	.certificate-entry { display: grid; grid-template-columns: minmax(0, 1fr) clamp(4.75rem, 13vw, 8rem); gap: 0.75rem; align-items: center; padding: 0.8rem 0.35rem; border-top: 1px solid var(--color-border); }
	.certificate-entry:is(:hover, :focus-visible) { background: var(--color-paper); }
	.certificate-entry:is(:hover, :focus-visible) .certificate-action { color: var(--color-accent); }
	.document-type { color: var(--color-accent); }
	.certificate-preview { aspect-ratio: 4 / 3; min-width: 0; background: var(--color-paper); }
	.certificate-preview img { display: block; width: 100%; height: 100%; object-fit: contain; }
	.certificate-preview img[hidden], .preview-fallback[hidden] { display: none; }
	.preview-fallback { display: grid; place-content: center; min-height: 100%; padding: 0.35rem; color: var(--color-muted); font-size: var(--text-label); text-align: center; }
	.certificate-copy { min-width: 0; }
	h3 { margin: 0; font-size: 1.125rem; line-height: 1.25; }
	.certificate-meta { margin: 0.25rem 0 0; color: var(--color-muted); font-size: var(--text-meta); }
	.certificate-action { display: inline-block; margin-top: 0.4rem; font-size: var(--text-meta); font-weight: 500; text-decoration: underline; text-underline-offset: 0.22em; }
	@media (max-width: 760px) {
		.certificates-hero, .certificate-register { grid-template-columns: minmax(0, 1fr); }
		.certificate-entry { grid-template-columns: minmax(0, 1fr) clamp(5rem, 21vw, 8rem); }
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLImageElement>('[data-certificate-preview]').forEach(image => {
			const showFallback = () => {
				image.hidden = true;
				const fallback = image.nextElementSibling;
				if (fallback instanceof HTMLElement) fallback.hidden = false;
			};
			if (image.complete && !image.naturalWidth) showFallback();
			else image.addEventListener('error', showFallback, { once: true });
		});
	});
</script>
