---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import { churchAttendance as project } from '../../content/projects/church-attendance';
import { writtenProjects } from '../../content/projects/written-projects';
---

<BaseLayout title="Projects — Ronie Pactol" description="Explore Ronie Pactol’s software projects, including the Church Attendance & Management System built with Laravel, Vue.js, and MySQL.">
	<div class="page-shell projects-page">
		<ProjectHero />
		<div id="project-list">
		<article class="project-entry" aria-labelledby="attendance-project-title">
			<div class="project-overview">
				<p class="project-context">{project.organization} · {project.role}</p>
				<h2 id="attendance-project-title"><a href="/projects/church-attendance/">{project.title}</a></h2>
				<p class="project-summary">{project.summary}</p>
				<p class="project-stack">{project.stack.join(' · ')}</p>
				<div class="project-actions"><a class="case-link" href="/projects/church-attendance/">Read the case study <span aria-hidden="true">↗</span></a><a class="case-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">Open live system <span aria-hidden="true">↗</span></a></div>
			</div>
			<a class="project-preview" href="/projects/church-attendance/" aria-label="Explore the Church Attendance and Management System case study"><img src={project.screenshots[0].src} width={project.screenshots[0].width} height={project.screenshots[0].height} alt={project.screenshots[0].alt} decoding="async" /></a>
		</article>
		<div class="written-projects">
			{writtenProjects.map(item => <article class="written-entry" aria-labelledby={`${item.slug}-title`}>
				<div class="written-title"><p class="project-context">{item.organization}</p><h2 id={`${item.slug}-title`}><a href={`/projects/${item.slug}/`}>{item.title}</a></h2><p class="project-kind">{item.kind}</p></div>
				<div class="written-summary"><p class="project-summary">{item.summary}</p>{item.stack.length > 0 && <p class="project-stack">{item.stack.join(' · ')}</p>}<a class="case-link" href={`/projects/${item.slug}/`}>Project details <span aria-hidden="true">↗</span></a></div>
			</article>)}
		</div>
		</div>
	</div>
</BaseLayout>

<style>
	.projects-page { padding-block: clamp(1.5rem, 4vw, 3.5rem); }
	.project-entry { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding-block: 2.5rem; border-bottom: 1px solid var(--color-border); }
	.project-context, .project-stack { margin: 0; color: var(--color-muted); font-size: 0.85rem; line-height: 1.7; }
	h2 { margin: 0.75rem 0 1rem; font-size: clamp(1.5rem, 3vw, 2.7rem); line-height: 1.15; }
	.project-summary { margin: 0 0 1rem; font-size: 1rem; line-height: 1.7; }
	.case-link { display: inline-flex; align-items: center; gap: 1rem; min-height: 44px; margin-top: 1rem; text-decoration: underline; text-underline-offset: 0.3em; font-size: 0.9rem; }
	.project-actions { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
	.project-preview { display: block; min-width: 0; border: 1px solid var(--color-border); }
	.project-preview img { display: block; width: 100%; height: auto; }
	.written-entry { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 1rem clamp(1.5rem, 4vw, 4rem); padding-block: 2rem; border-bottom: 1px solid var(--color-border); }
	.written-entry h2 { margin-block: 0.5rem 0.75rem; max-width: 30ch; font-size: clamp(1.35rem, 2.3vw, 2rem); }
	.project-kind { margin: 0; color: var(--color-muted); font-size: 0.8rem; line-height: 1.6; }
	.written-entry .project-summary { margin-bottom: 0.5rem; }
	.written-entry .case-link { margin-top: 0.5rem; }
	@media (min-width: 901px) {
		.projects-page { padding-block: 1.5rem; }
		.project-entry { gap: 1.5rem; padding-block: 1.5rem; }
		h2 { font-size: 1.75rem; }
		.project-summary { font-size: 0.875rem; }
		.written-entry { gap: 0.75rem 1.5rem; padding-block: 1.25rem; }
		.written-entry h2 { font-size: 1.5rem; }
	}
	@media (max-width: 900px) { .project-entry { grid-template-columns: minmax(0, 1fr); } }
	@media (max-width: 640px) {
		.project-summary { font-size: var(--mobile-body); line-height: 1.65; }
		.project-entry { padding-block: 1.5rem; gap: 1rem; }
		.written-entry { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; padding-block: 1.5rem; }
		h2 { margin-block: 0.5rem 0.75rem; }
	}
</style>
