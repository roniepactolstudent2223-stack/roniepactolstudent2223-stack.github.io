---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import SelectedWork from '../components/SelectedWork.astro';

const focusAreas = [
	{ title: 'Business workflows', description: 'Validated entries, approval steps, and reporting for internal systems.', link: '/projects/closing-process-automation/', evidence: 'Closing process work' },
	{ title: 'Web interfaces', description: 'Vue.js interfaces for QR check-in, member records, and administration.', link: '/projects/church-attendance/', evidence: 'Church attendance system' },
	{ title: 'APIs & automation', description: 'REST integrations, account synchronization, and scheduled background updates.', link: '/experience/#wilcon-depot', evidence: 'Systems development experience' },
];
---

<BaseLayout title="Ronie Pactol — Full-Stack Developer" description="Ronie Pactol builds web systems with Laravel, Vue.js, PHP, and MySQL. Explore church software, business-system contributions, and practical developer tools.">
	<div class="page-shell">
		<section class="home-hero" id="home" aria-labelledby="intro-title">
			<div class="hero-copy">
					<p class="hero-eyebrow eyebrow"><span class="hero-rule" aria-hidden="true"></span> Developer portfolio</p>
					<p class="hero-name">Ronie Pactol <span>Full-stack developer</span></p>
					<h1 id="intro-title">Web systems for<br /> <em>the work behind the scenes.</em></h1>
					<p class="hero-description">I build with Laravel and Vue.js, connecting day-to-day tasks with the systems behind them—from church check-ins to accounting workflows.</p>
					<div class="hero-actions">
						<a class="button button-primary" href="/projects/">Explore projects <span aria-hidden="true">↗</span></a>
						<a class="github-button" href="https://github.com/NiessenWaffer" target="_blank" rel="noreferrer" aria-label="GitHub (opens in a new tab)" title="GitHub"><svg class="github-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2m12 5v-4a3.5 3.5 0 0 0-1-3c3-.4 6-1.5 6-6a4.7 4.7 0 0 0-1.3-3.3 4.3 4.3 0 0 0-.1-3.2S17.5 2.1 15 3.8a11 11 0 0 0-6 0C6.5 2.1 5.4 2.5 5.4 2.5a4.3 4.3 0 0 0-.1 3.2A4.7 4.7 0 0 0 4 9c0 4.5 3 5.6 6 6a3.5 3.5 0 0 0-1 3v4" /></svg><span class="github-label">GitHub <span aria-hidden="true">↗</span></span></a>
						<a class="github-button linkedin-button" href="https://www.linkedin.com/in/ronie-pactol-6888092a6" target="_blank" rel="noopener noreferrer" aria-label="Ronie Pactol on LinkedIn (opens in a new tab)" title="LinkedIn"><svg class="github-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M7 10v7M7 7h.01M11 17v-7m0 3a3 3 0 0 1 6 0v4" /></svg><span class="github-label">LinkedIn <span aria-hidden="true">↗</span></span></a>
					</div>
			</div>
			<aside class="hero-context" aria-label="Availability and core technologies">
				<p class="eyebrow">Currently</p>
				<p class="availability">Open to freelance work<br /> and full-stack roles</p>
				<dl>
					<div><dt class="field-label">Working with</dt><dd>Laravel · Vue.js<br /> PHP · MySQL</dd></div>
					<div><dt class="field-label">Based in</dt><dd>Quezon City,<br /> Metro Manila</dd></div>
				</dl>
			</aside>
		</section>

		<SelectedWork />
		<section class="expertise" aria-labelledby="expertise-title">
			<header class="section-heading"><div><p class="eyebrow">Development focus</p><h2 id="expertise-title">Where I contribute.</h2></div><p class="expertise-note">From the interface<br /> to the underlying workflow.</p></header>
			<div class="expertise-grid">
				{focusAreas.map((area, index) => <article class="expertise-item">
					<p class="expertise-index" aria-hidden="true">0{index + 1}</p>
					<h3>{area.title}</h3><p>{area.description}</p>
					<a class="text-link" href={area.link}>{area.evidence}<span aria-hidden="true">↗</span></a>
				</article>)}
			</div>
		</section>
		<About />
	</div>
</BaseLayout>

<style>
	.home-hero { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; align-items: end; gap: 2rem; padding-block: 2.25rem 2rem; border-bottom: 1px solid var(--color-ink); }
	.hero-copy { min-width: 0; }
	.hero-eyebrow { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.25rem; }
	.hero-rule { width: 1.5rem; height: 1px; background: currentColor; }
	.hero-name { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin: 0 0 0.65rem; font-size: var(--text-meta); font-weight: 500; }
	.hero-name span { color: var(--color-muted); font-weight: 400; }
	h1 { max-width: 24ch; font-size: clamp(2.3rem, 4vw, 3.25rem); line-height: 1.08; letter-spacing: -0.025em; text-wrap: balance; }
	h1 em { color: var(--color-accent); }
	.hero-description { max-width: 52ch; margin: 1rem 0 1.25rem; color: var(--color-muted); font-size: var(--text-body); line-height: var(--line-body); }
	.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
	.github-button { display: inline-flex; align-items: center; gap: 0.4rem; min-height: var(--control-height); padding: 0.4rem 0.6rem; font-size: 0.8rem; text-decoration: underline; text-underline-offset: 0.25em; }
	.github-icon { width: 17px; height: 17px; flex: none; }
	.hero-context { padding-left: 1.25rem; border-left: 2px solid var(--color-olive); }
	.hero-context .eyebrow { color: #4f5944; }
	.hero-context .availability { margin: 0 0 1.25rem; color: var(--color-ink); font-size: 0.95rem; font-weight: 500; line-height: 1.5; }
	.hero-context dl { margin: 0; }
	.hero-context dl > div { margin-top: 1rem; }
	.hero-context dd { margin: 0; font-size: var(--text-meta); line-height: 1.6; }
	.expertise { padding-block: 2rem; border-bottom: 1px solid var(--color-ink); }
	.expertise-note { margin: 0; color: var(--color-muted); font-size: var(--text-meta); line-height: 1.6; }
	.expertise-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
	.expertise-item { display: flex; flex-direction: column; align-items: start; min-width: 0; padding-top: 1rem; border-top: 1px solid var(--color-border); }
	.expertise-index { margin: 0 0 0.8rem; color: var(--color-olive); font: 500 var(--text-label)/1.6 var(--font-label); }
	.expertise-item h3 { margin: 0 0 0.5rem; font-size: 1.05rem; line-height: 1.3; }
	.expertise-item > p:not(.expertise-index) { margin: 0 0 0.75rem; color: var(--color-muted); font-size: 0.875rem; line-height: 1.7; }
	.expertise-item .text-link { margin-top: auto; font-size: 0.75rem; line-height: 1.5; }
	@media (max-width: 760px) {
		.home-hero { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; padding-block: 1.5rem; }
		h1 { font-size: var(--mobile-title); max-width: 24ch; }
		h1 br { display: none; }
		.hero-description { font-size: var(--mobile-body); }
		.hero-eyebrow { margin-bottom: 0.75rem; }
		.hero-context { padding: 1rem; border-left: 0; border-top: 2px solid var(--color-olive); background: var(--color-sage); }
		.hero-context .availability { margin-bottom: 0; }
		.hero-context dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
		.hero-context .availability br { display: none; }
		.hero-actions { gap: 0.4rem; }
		.github-button { padding-inline: 0.4rem; }
		.expertise { padding-block: 1.5rem; }
		.expertise-grid { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
		.expertise-item { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); column-gap: 0.75rem; }
		.expertise-index { grid-row: span 3; padding-top: 0.15rem; }
		.expertise-item > p:not(.expertise-index) { font-size: var(--mobile-body); }
		.expertise-note { display: none; }
	}
	@media (max-width: 380px) { .hero-actions > .button { flex-basis: 100%; } }
</style>
