---
import ScreenshotViewer from './ScreenshotViewer.astro';

const events = [
	{
		id: 'wordpress-manila', title: 'WordPress Manila Meetup', date: 'July 2026', datetime: '2026-07',
		image: 'wordpress-manila', alt: 'WordPress Manila Meetup attendees gathered for a group photo at Common Ground Work Philippines Don Antonio.',
		description: 'I volunteered as a photographer at the July 2026 WordPress Manila Meetup, documenting a gathering of the local WordPress community.',
		context: 'An opportunity for attendees to learn, share, and connect, hosted at Common Ground Work Philippines Don Antonio.',
		supportLabel: 'Venue sponsor', supporters: 'Common Ground Work Philippines Don Antonio',
	},
	{
		id: 'software-freedom-day', title: 'Software Freedom Day Manila', date: '2026', datetime: '2026',
		image: 'software-freedom-day', alt: 'Software Freedom Day Manila attendees posing together in front of a Huawei event screen.',
		description: 'I volunteered as a photographer for Software Freedom Day 2026 Manila, capturing a celebration of free and open-source software under the theme “The Future Is Open.”',
		context: 'The gathering brought together developers, designers, students, advocates, creators, and open-source enthusiasts.',
		supportLabel: 'Sponsor & supporter', supporters: 'Sponsored by Huawei Cloud Developer Group Philippines, with support from the Digital Freedom Foundation.',
	},
	{
		id: 'camanava-campus', title: 'WordPress Camanava Campus Meetup', date: 'August 2025', datetime: '2025-08',
		image: 'camanava-campus', alt: 'WordPress Camanava Campus Meetup attendees gathered with WordPress Manila community signs.',
		description: 'I volunteered as a photographer at the August 2025 WordPress Camanava Campus Meetup, documenting the people behind a day of learning, sharing, and connection.',
		context: 'Attendees, speakers, organizers, and fellow volunteers came together to share knowledge and meet the community.',
		supportLabel: 'Meetup partners', supporters: 'WCC Aeronautical & Technological College · LevelUp · DEVCON',
	},
];
---

<section class="community-intro page-intro page-intro--dark" aria-labelledby="community-title">
	<div>
		<h1 id="community-title">Community &amp; <em>volunteering.</em></h1>
	</div>
	<p class="community-summary">I volunteer as an event photographer for local WordPress and open-source communities.</p>
</section>


<div class="community-events">
	{events.map((event, index) => (
		<article class:list={['community-event', { 'lead-event': index === 0 }]} id={event.id} aria-labelledby={`${event.id}-title`}>
			<figure>
				<a href={`/images/${event.image}-1600.webp`} data-screenshot data-fit data-title={event.title} data-alt={event.alt} data-width="1600" data-height="900" target="_blank" rel="noopener noreferrer" aria-label={`View the ${event.title} group photo`}>
					<img src={`/images/${event.image}-1600.webp`} srcset={`/images/${event.image}-800.webp 800w, /images/${event.image}-1600.webp 1600w`} sizes={index === 0 ? '(max-width: 760px) 92vw, (max-width: 1100px) 66vw, 720px' : '(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 510px'} width="1600" height="900" alt={event.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
					<span class="photo-action">View photo <span aria-hidden="true">↗</span></span>
				</a>
			</figure>
			<div class="event-copy">
				<time class="field-label" datetime={event.datetime}>{event.date}</time>
				<h2 id={`${event.id}-title`}>{event.title}</h2>
				<p class="event-description">{event.description}</p>
				<details class="event-context">
					<summary>About the gathering</summary>
					<p>{event.context}</p>
					<dl><dt>{event.supportLabel}</dt><dd>{event.supporters}</dd></dl>
				</details>
			</div>
		</article>
	))}
</div>

<ScreenshotViewer />

<style>
	.community-intro { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: end; gap: 1.5rem; }
	.community-intro h1 { max-width: 18ch; line-height: 1.06; }
	.community-intro em { display: inline; padding: 0; background: none; color: var(--color-accent); }
	.community-summary { max-width: 40ch; margin: 0; font-size: var(--text-body); line-height: var(--line-body); }
	.community-events { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 2.5rem); padding-block: 1.5rem 2.5rem; }
	.community-event { min-width: 0; }
	.lead-event { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); align-items: center; gap: 1.25rem; padding: clamp(0.75rem, 2vw, 1.25rem); background: var(--color-tint); }
	.event-copy { min-width: 0; }
	.community-event:not(.lead-event) .event-copy { margin-top: 0.85rem; }
	time { color: var(--color-accent); }
	h2 { margin: 0; max-width: 26ch; font-size: var(--text-section); line-height: 1.15; }
	.event-description { max-width: 58ch; margin: 0.65rem 0 0; color: var(--color-muted); font-size: 0.95rem; line-height: var(--line-body); }
	.event-context { margin-top: 0.5rem; font-size: var(--text-meta); line-height: var(--line-body); }
	.event-context summary { min-height: 44px; padding-block: 0.6rem; cursor: pointer; text-decoration: underline; text-underline-offset: 0.25em; }
	.event-context p { margin: 0 0 0.75rem; color: var(--color-muted); }
	dl { margin: 0; }
	dt { color: var(--color-muted); font-family: var(--font-label); font-size: var(--text-label); letter-spacing: var(--tracking-label); text-transform: uppercase; }
	dd { margin: 0.25rem 0 0; }
	figure { min-width: 0; margin: 0; }
	figure > a { display: block; position: relative; background: var(--color-paper); }
	figure img { display: block; width: 100%; height: auto; }
	.photo-action { position: absolute; inset: auto 0.5rem 0.5rem auto; display: inline-flex; gap: 0.4rem; align-items: center; padding: 0.35rem 0.6rem; background: var(--color-paper); color: var(--color-ink); font-size: var(--text-meta); font-weight: 500; }
	figure > a:is(:hover, :focus-visible) .photo-action { background: var(--color-ink); color: var(--color-paper); }
	@media (prefers-reduced-motion: no-preference) {
		.photo-action { transition: background-color var(--motion-fast), color var(--motion-fast); }
	}
	@media (max-width: 900px) {
		.community-intro { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
		.community-summary { max-width: 60ch; }
	}
	@media (max-width: 760px) { .lead-event { grid-template-columns: minmax(0, 1fr); } }
	@media (max-width: 640px) {
		.community-intro h1 { font-size: var(--mobile-title); line-height: 1.15; }
		.community-events { grid-template-columns: minmax(0, 1fr); }
	}
</style>
