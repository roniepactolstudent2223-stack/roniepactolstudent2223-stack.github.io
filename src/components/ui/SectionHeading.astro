---
interface Props { eyebrow?: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
	{eyebrow && <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-neutral-500">{eyebrow}</p>}
	<h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
	{description && <p class="mt-4 text-lg leading-8 text-neutral-600">{description}</p>}
</div>
