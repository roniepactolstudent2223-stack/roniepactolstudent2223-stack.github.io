---
interface Props { total: number; }
const { total } = Astro.props;
---

<header class="projects-hero" aria-labelledby="projects-title">
	<div>
		<p class="projects-eyebrow">Selected work <span>{String(total).padStart(2, '0')} projects</span></p>
		<h1 id="projects-title">Projects that make<br /> <em>daily work simpler.</em></h1>
	</div>
	<p class="projects-introduction">Church software, business workflows, and practical tools. Explore the systems I’ve worked on and the problems behind them.</p>
</header>

<style>
	.projects-hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: end; gap: 1.5rem 3rem; padding-bottom: 1.5rem; }
	.projects-eyebrow { display: flex; align-items: center; gap: 1rem; margin: 0 0 0.75rem; font-size: 0.75rem; color: var(--color-olive); }
	.projects-eyebrow span { color: var(--color-muted); font-variant-numeric: tabular-nums; }
	h1 { margin: 0; font-size: 2.25rem; line-height: 1.12; }
	h1 em { display: inline; padding: 0; background: none; color: var(--color-accent); }
	.projects-introduction { max-width: 42ch; margin: 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.65; }
	@media (max-width: 760px) {
		.projects-hero { grid-template-columns: minmax(0, 1fr); gap: 0.85rem; padding-bottom: 1.25rem; }
		h1 { font-size: var(--mobile-title, 2rem); line-height: 1.15; }
		.projects-introduction { max-width: 50ch; font-size: var(--mobile-body, 0.95rem); }
	}
</style>
