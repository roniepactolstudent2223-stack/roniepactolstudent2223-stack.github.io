<script>
	let removeLayoutListener: (() => void) | undefined;

	document.addEventListener('astro:page-load', () => {
		removeLayoutListener?.();
		const disclosures = document.querySelectorAll<HTMLDetailsElement>('.experience-disclosure');
		if (!disclosures.length) return;

		const phoneLayout = window.matchMedia('(max-width: 760px)');
		const phoneStates = new Map<HTMLDetailsElement, boolean>();
		disclosures.forEach((details) => {
			phoneStates.set(details, details.open);
			details.querySelector('summary')?.addEventListener('click', () => {
				if (phoneLayout.matches) phoneStates.set(details, !details.open);
			});
		});

		const setLayout = () => {
			disclosures.forEach((details) => {
				details.open = phoneLayout.matches ? phoneStates.get(details) ?? false : true;
				details.toggleAttribute('data-expanded-layout', !phoneLayout.matches);
			});
		};
		setLayout();
		phoneLayout.addEventListener('change', setLayout);
		removeLayoutListener = () => phoneLayout.removeEventListener('change', setLayout);
	});
</script>
