</style>

<script>
	let disposeExperience: (() => void) | undefined;

	document.addEventListener('astro:page-load', () => {
		disposeExperience?.();
		const sheet = document.querySelector<HTMLDialogElement>('#experience-sheet');
		if (!sheet || typeof sheet.showModal !== 'function') return;
		const sections = document.querySelectorAll<HTMLElement>('.experience-section');
		const scroll = sheet.querySelector<HTMLElement>('.sheet-scroll')!;
		const content = sheet.querySelector<HTMLElement>('.sheet-content')!;
		const closeButton = sheet.querySelector<HTMLButtonElement>('.sheet-close')!;
		const phoneLayout = window.matchMedia('(max-width: 760px)');
		const controller = new AbortController();
		const { signal } = controller;
		let active: { section: HTMLElement; body: HTMLElement; home: HTMLDetailsElement; first: Element | null } | null = null;
		let closeVersion = 0;

		const restoreContent = () => {
			if (!active) return;
			if (active.first) active.body.prepend(active.first);
			active.home.append(active.body);
			active = null;
		};
		const closeSheet = (immediate = false) => {
			const section = active?.section;
			const version = ++closeVersion;
			if (sheet.open) sheet.close();
			if (section?.isConnected) {
				const focusTarget = phoneLayout.matches ? section.querySelector<HTMLElement>('.experience-open') : section.querySelector<HTMLElement>('h2');
				if (focusTarget) {
					if (!phoneLayout.matches) focusTarget.tabIndex = -1;
					focusTarget.focus({ preventScroll: true });
				}
			}
			if (immediate) { restoreContent(); return; }
			// Preserve the real content through the exit; rapid reopening invalidates this cleanup.
			Promise.allSettled(sheet.getAnimations().map(animation => animation.finished)).then(() => {
				if (version === closeVersion && !sheet.open) restoreContent();
			});
		};
		sections.forEach(section => {
			const trigger = section.querySelector<HTMLButtonElement>('.experience-open')!;
			trigger.addEventListener('click', () => {
				if (!phoneLayout.matches || sheet.open) return;
				++closeVersion;
				restoreContent();
				const home = section.querySelector<HTMLDetailsElement>('.experience-disclosure')!;
				const body = home.querySelector<HTMLElement>('.experience-body')!;
				active = { section, body, home, first: body.firstElementChild };
				const responsibilities = body.querySelector<HTMLElement>(':scope > .experience-details, :scope > .experience-list');
				if (responsibilities) body.prepend(responsibilities);
				sheet.querySelector<HTMLElement>('#experience-sheet-title')!.textContent = section.querySelector('h2')!.textContent;
				sheet.querySelector<HTMLElement>('.sheet-organization')!.textContent = section.querySelector('.experience-meta span:first-child')!.textContent;
				sheet.querySelector<HTMLElement>('#experience-sheet-meta')!.textContent = section.querySelector('.experience-meta span:last-child')!.textContent;
				sheet.querySelector<HTMLElement>('.sheet-summary')!.textContent = section.querySelector('.experience-summary')!.textContent;
				content.append(body);
				scroll.scrollTop = 0;
				sheet.showModal();
			}, { signal });
		});
		closeButton.addEventListener('click', () => closeSheet(), { signal });
		sheet.addEventListener('cancel', event => { event.preventDefault(); closeSheet(); }, { signal });
		let backdropPressed = false;
		sheet.addEventListener('pointerdown', event => { backdropPressed = event.target === sheet; }, { signal });
		sheet.addEventListener('click', event => {
			const bounds = sheet.getBoundingClientRect();
			if (backdropPressed && event.target === sheet && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) closeSheet();
			backdropPressed = false;
		}, { signal });

		const setLayout = () => {
			if (!phoneLayout.matches && active) closeSheet(true);
			sections.forEach(section => {
				const details = section.querySelector<HTMLDetailsElement>('.experience-disclosure')!;
				details.open = !phoneLayout.matches;
				details.toggleAttribute('data-expanded-layout', !phoneLayout.matches);
				section.toggleAttribute('data-sheet-ready', phoneLayout.matches);
				section.querySelector<HTMLButtonElement>('.experience-open')!.hidden = !phoneLayout.matches;
			});
		};
		setLayout();
		phoneLayout.addEventListener('change', setLayout, { signal });
		document.addEventListener('astro:before-preparation', () => closeSheet(true), { signal });
		disposeExperience = () => { closeSheet(true); controller.abort(); };
	});
</script>
