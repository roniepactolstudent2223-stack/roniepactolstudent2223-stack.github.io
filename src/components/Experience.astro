	.experience-sheet { box-sizing: border-box; position: fixed; inset: 0 0 0 auto; width: min(calc(100% - 0.75rem), 32rem); max-width: none; height: 100dvh; max-height: 100dvh; margin: 0 0 0 auto; padding: 0; border: 0; border-left: 1px solid var(--color-border); border-radius: 0.65rem 0 0 0.65rem; background: var(--color-paper); color: var(--color-ink); overflow: hidden; box-shadow: -1rem 0 3rem #0002; }
	.experience-sheet[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
	.experience-sheet::backdrop { background: rgb(20 22 23 / 55%); }
	:global(html:has(.experience-sheet[open])) { overflow: hidden; }
	.sheet-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: max(0.375rem, env(safe-area-inset-top)) 1rem 0.375rem; border-bottom: 1px solid var(--color-border); }
	.sheet-toolbar p { margin: 0; color: var(--color-muted); font-size: 0.8rem; }
	.sheet-close { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0.25rem; border: 0; background: none; color: inherit; font: inherit; font-size: 0.85rem; cursor: pointer; }
	.sheet-close span { font-size: 1.5rem; line-height: 1; }
	.sheet-scroll { min-width: 0; min-height: 0; padding: 1.25rem 1rem max(1.25rem, env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; scroll-padding-block: 1rem; }
