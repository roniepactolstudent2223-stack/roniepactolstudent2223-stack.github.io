	.sheet-organization { margin: 0 0 0.6rem; color: var(--color-accent); font-size: 0.8rem; line-height: 1.6; }
	.sheet-intro h2 { margin: 0; font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem); line-height: 1.15; overflow-wrap: anywhere; }
	#experience-sheet-meta { margin: 0.6rem 0 0; color: var(--color-muted); font-size: 0.8rem; line-height: 1.6; }
	.sheet-summary { margin: 0.75rem 0 0; font-size: var(--mobile-body, 0.95rem); line-height: 1.6; }
	.experience-sheet .experience-body { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; padding: 0; }
	.experience-sheet .experience-list li { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; padding-block: 0.75rem; font-size: var(--mobile-body, 0.95rem); }
	.experience-sheet :is(a, button):focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }
	@media (min-width: 901px) {
		.experience-section { padding-block: 0.75rem 1.75rem; }
		.experience-heading { gap: 1.25rem; padding: 1.25rem 1rem 1rem; }
		.experience-heading h2 { font-size: 2.25rem; line-height: 1.12; }
		.church-experience .experience-heading h2 { font-size: 2rem; }
		.service-experience .experience-heading h2 { font-size: 1.75rem; }
		.experience-meta { margin-top: 0.75rem; font-size: 0.8125rem; }
		.experience-body { gap: 1.5rem; padding-inline: 1rem; }
		.experience-summary, .service-experience .experience-summary { margin-top: 0.75rem; font-size: 0.875rem; }
		.experience-list li { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; padding-block: 0.625rem; font-size: 0.875rem; line-height: 1.55; }
	}
	@media (max-width: 1100px) { .experience-heading, .experience-body { padding-inline: 0; } .experience-body { gap: 2rem; } .experience-list li { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; } }
	@media (min-width: 761px) and (max-width: 900px) {
		.experience-section { padding-block: 1rem 2rem; }
		.experience-heading { padding-block: 1.5rem; }
		.experience-section .experience-heading h2 { font-size: 2.25rem; line-height: 1.12; }
		.experience-meta { margin-top: 0.75rem; font-size: 0.85rem; }
		.experience-summary { font-size: 1rem; }
		.experience-body { gap: 1.5rem; }
	}
	@media (max-width: 760px) {
		.experience-page-heading { display: block; padding-block: 1.25rem 0.5rem; }
		.experience-page-heading h1 { font-size: 1.75rem; }
		.experience-page-heading p { margin-top: 0.35rem; }
		.experience-section { padding-block: 1.25rem; }
		.experience-section .experience-heading { display: block; padding: 0 0 0 0.875rem; border-left: 2px solid var(--color-accent); }
		.experience-section .experience-heading h2 { font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem); line-height: 1.15; }
		.experience-heading h2 br { display: none; }
		.experience-meta { flex-direction: column; gap: 0.15rem; margin-top: 0.6rem; font-size: 0.8rem; }
		.experience-meta span:first-child { color: var(--color-ink); }
