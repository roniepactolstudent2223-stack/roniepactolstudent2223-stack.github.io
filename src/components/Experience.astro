---
import { Image } from 'astro:assets';
import wilconOffice from '../../public/images/wilconDepotOffice.png';
---

<header class="experience-page-heading" aria-labelledby="experience-page-title">
	<div class="experience-page-heading-copy">
		<p class="experience-kicker">Work &amp; service <span aria-hidden="true">/</span> 2024—present</p>
		<h1 id="experience-page-title">Experience<span>.</span></h1>
		<p class="experience-page-summary">Systems development, church ministry, and earlier service work.</p>
	</div>
	<nav class="experience-contents" aria-label="Experience chapters">
		<a href="#word-of-hope"><span>01</span> Ministry <span aria-hidden="true">↓</span></a>
		<a href="#wilcon-depot"><span>02</span> Development <span aria-hidden="true">↓</span></a>
		<a href="#jollibee"><span>03</span> Service <span aria-hidden="true">↓</span></a>
	</nav>
</header>

<section class="experience-section church-experience" id="word-of-hope" aria-labelledby="church-experience-title">
	<div class="experience-record" aria-hidden="true"><span class="record-number">01</span><span class="record-type">Ministry</span></div>
	<div class="ministry-intro">
	<figure class="ministry-photo">
		<img src="/images/word-of-hope-1200.webp" srcset="/images/word-of-hope-600.webp 600w, /images/word-of-hope-1200.webp 1200w" sizes="(max-width: 760px) calc(100vw - 2rem), 480px" width="1200" height="675" alt="Word of Hope Caloocan church building beside EDSA" class="church-image" decoding="async" />
	</figure>
	<div class="experience-heading">
		<div>
			<h2 id="church-experience-title">Developer ministry<br /> <em>&amp; church service.</em></h2>
			<p class="experience-meta"><span>Word of Hope Caloocan Church</span></p>
			<p class="experience-summary">I build and maintain software for the church’s ministry teams.</p>
		</div>
	</div>
	</div>
	<button class="experience-open" type="button" aria-haspopup="dialog" aria-controls="experience-sheet" aria-label="View developer ministry experience at Word of Hope Caloocan Church" hidden>View experience <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg></button>
	<details class="experience-disclosure">
		<summary aria-label="Responsibilities & photos at Word of Hope Caloocan Church"><span>Responsibilities &amp; photos</span><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 10h12" /><path class="disclosure-plus" d="M10 4v12" /></svg></summary>
		<div class="experience-body">
			<div class="experience-details">
				<ul class="experience-list">
					<li><strong>Church software</strong><span>Maintain existing software and build systems requested by ministry teams.</span></li>
					<li><strong>Ministry collaboration</strong><span>Work with ministry teams and other professionals to plan and support their systems.</span></li>
					<li><strong>Events &amp; service</strong><span>Help organize gatherings, volunteer as a photographer, and serve as a church worker.</span></li>
				</ul>
				<div class="experience-location">
					<address class="experience-address">474 EDSA, Barangay 87, Caloocan City, Philippines</address>
					<a class="organization-link" href="https://wohcaloocan.org/" target="_blank" rel="noopener noreferrer">Visit church website <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</div>
	</details>
</section>

<section class="experience-section" id="wilcon-depot" aria-labelledby="experience-title">
	<div class="experience-record" aria-hidden="true"><span class="record-number">02</span><span class="record-type">Development</span></div>
	<div class="experience-heading">
		<div>
			<h2 id="experience-title">Junior system<br /> <em>developer.</em></h2>
			<p class="experience-meta"><span>Wilcon Depot, Inc.</span><span>May 2026 — October 2026</span></p>
			<p class="experience-summary">Full-stack development for internal business systems using Laravel, Vue.js, PHP, and MySQL.</p>
		</div>
	</div>
	<button class="experience-open" type="button" aria-haspopup="dialog" aria-controls="experience-sheet" aria-label="View junior system developer experience at Wilcon Depot" hidden>View experience <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg></button>
	<details class="experience-disclosure">
		<summary aria-label="Responsibilities & photos at Wilcon Depot"><span>Responsibilities &amp; photos</span><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 10h12" /><path class="disclosure-plus" d="M10 4v12" /></svg></summary>
		<div class="experience-body">
			<div class="experience-image-wrap">
				<Image src={wilconOffice} widths={[480, 800, 1200]} sizes="(max-width: 760px) calc(100vw - 2rem), 420px" format="webp" alt="Wilcon Depot office" class="experience-image" loading="lazy" />
			</div>
			<div class="experience-details">
				<ul class="experience-list">
					<li><strong>Web application development</strong><span>Built and maintained internal business web applications using PHP (Laravel 7), Vue.js 2, and MySQL.</span></li>
					<li><strong>System automation &amp; integration</strong><span>Connected internal web tools with the company ERP system and set up automated background tasks to keep data synced across departments.</span></li>
					<li><strong>Database &amp; data validation</strong><span>Wrote database queries and strict validation rules to process high-volume operational and accounting records accurately.</span></li>
					<li><strong>Team collaboration &amp; testing</strong><span>Worked with business analysts, senior developers, and QA testers to turn requirements into working features, fix bugs, and support user testing before launch.</span></li>
				</ul>
				<div class="experience-location"><address class="experience-address">#90 E. Rodriguez Jr. Avenue, Barangay Ugong Norte, Libis, Quezon City, 1110 Metro Manila, Philippines</address></div>
			</div>
		</div>
	</details>
</section>

<section class="experience-section service-experience" id="jollibee" aria-labelledby="jollibee-title">
	<div class="experience-record" aria-hidden="true"><span class="record-number">03</span><span class="record-type">Service</span></div>
	<div class="experience-heading">
		<div>
			<h2 id="jollibee-title">Service <em>crew.</em></h2>
			<p class="experience-meta"><span>Jollibee · Part-time</span><span>January 2024 — May 2024</span></p>
			<p class="experience-summary">Worked part-time as a Jollibee service crew member while continuing my studies.</p>
		</div>
	</div>
	<button class="experience-open" type="button" aria-haspopup="dialog" aria-controls="experience-sheet" aria-label="View service crew experience at Jollibee" hidden>View experience <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg></button>
	<details class="experience-disclosure">
		<summary aria-label="Responsibilities & photos at Jollibee"><span>Responsibilities &amp; photos</span><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 10h12" /><path class="disclosure-plus" d="M10 4v12" /></svg></summary>
		<div class="experience-body service-body">
			<div>
				<a class="organization-link" href="https://www.jollibee.com.ph/" target="_blank" rel="noopener noreferrer">Jollibee Philippines <span aria-hidden="true">↗</span></a>
				<div class="service-photos">
					<figure><a href="/images/JollibbeeSelfie.png" target="_blank" rel="noopener noreferrer" aria-label="Open Ronie’s Jollibee uniform photo at original size"><img src="/images/JollibbeeSelfie.png" width="562" height="749" alt="Ronie wearing his Jollibee service crew uniform." loading="lazy" decoding="async" /></a><figcaption>In uniform</figcaption></figure>
					<figure><a href="/images/Jollibee.png" target="_blank" rel="noopener noreferrer" aria-label="Open the Jollibee restaurant photo at original size"><img src="/images/Jollibee.png" width="250" height="187" alt="Exterior of a Jollibee restaurant." loading="lazy" decoding="async" /></a><figcaption>Jollibee restaurant</figcaption></figure>
				</div>
			</div>
			<ul class="experience-list">
				<li><strong>Customer service</strong><span>Supported customer-facing restaurant service as part of the store crew.</span></li>
				<li><strong>Teamwork</strong><span>Worked alongside fellow crew members to support day-to-day restaurant service.</span></li>
				<li><strong>Working while studying</strong><span>Balanced part-time work with my studies from January to May 2024.</span></li>
			</ul>
		</div>
	</details>
</section>

<dialog class="experience-sheet" id="experience-sheet" aria-labelledby="experience-sheet-title" aria-describedby="experience-sheet-meta">
	<header class="sheet-toolbar"><p>Experience details</p><button class="sheet-close" type="button" autofocus>Close <span aria-hidden="true">×</span></button></header>
	<div class="sheet-scroll">
		<div class="sheet-intro">
			<p class="sheet-organization"></p>
			<h2 id="experience-sheet-title"></h2>
			<p id="experience-sheet-meta"></p>
			<p class="sheet-summary"></p>
		</div>
		<div class="sheet-content"></div>
	</div>
</dialog>

<style>
	.experience-page-heading { display: grid; grid-template-columns: minmax(0, 1fr) 11.5rem; align-items: end; gap: 2rem; padding: 1.75rem; border-bottom: 1px solid var(--color-ink); background: #edf0e9; }
	.experience-page-heading-copy { min-width: 0; }
	.experience-kicker { margin: 0 0 0.9rem; color: var(--color-olive); font-family: var(--font-label); font-size: var(--text-label); font-weight: 500; letter-spacing: var(--tracking-label); line-height: 1.7; text-transform: uppercase; }
	.experience-kicker span { margin-inline: 0.4rem; }
	.experience-page-heading h1 { margin: 0; font-family: var(--font-display); font-size: clamp(2.4rem, 4.5vw, 3.35rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.05; }
	.experience-page-heading h1 span { color: var(--color-accent); }
	.experience-page-summary { max-width: 41ch; margin: 0.8rem 0 0; color: var(--color-muted); font-size: var(--text-body); line-height: var(--line-body); }
	.experience-contents { display: grid; }
	.experience-contents a { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr) auto; align-items: center; gap: 0.4rem; min-height: 44px; border-top: 1px solid #aab39f; font-size: var(--text-meta); }
	.experience-contents a span:first-child { color: var(--color-olive); font-family: var(--font-label); font-size: var(--text-label); }
	.experience-contents a:hover { text-decoration: underline; text-underline-offset: 0.25em; }
	.experience-section { position: relative; display: grid; grid-template-columns: 5.75rem minmax(0, 1fr); column-gap: 1.5rem; padding-block: 1.75rem; border-bottom: 1px solid var(--color-border); }
	.experience-section:last-of-type { border-bottom-color: var(--color-ink); }
	.experience-record { grid-column: 1; grid-row: 1 / span 3; display: flex; flex-direction: column; align-items: start; gap: 0.6rem; padding-top: 0.2rem; }
	.record-number { display: inline-flex; align-items: center; justify-content: center; width: 1.8rem; height: 1.8rem; border: 1px solid var(--color-border); border-radius: 50%; color: var(--color-accent); font-family: var(--font-label); font-size: var(--text-label); }
	.record-type { color: var(--color-muted); font-family: var(--font-label); font-size: var(--text-label); letter-spacing: 0.035em; text-transform: uppercase; }
	.experience-section > :is(.ministry-intro, .experience-heading, .experience-open, .experience-disclosure) { grid-column: 2; min-width: 0; }
	.experience-heading { padding-bottom: 1.25rem; }
	.experience-heading > div { min-width: 0; }
	.experience-heading h2 { max-width: 28ch; margin: 0; font-family: var(--font-display); font-size: clamp(1.85rem, 3vw, 2.35rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.025em; }
	.experience-heading h2 em { color: var(--color-accent); }
	.experience-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 1rem; margin: 0.8rem 0 0; font-size: var(--text-meta); line-height: 1.6; }
	.experience-meta span:first-child { color: var(--color-ink); font-weight: 600; }
	.experience-meta span + span { color: var(--color-muted); font-family: var(--font-label); font-size: 0.7rem; }
	.experience-summary { max-width: 56ch; margin: 0.7rem 0 0; color: var(--color-muted); font-size: var(--text-body); line-height: var(--line-body); }
	.experience-open { display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; min-height: 44px; margin-top: 0.65rem; padding: 0.4rem 0; border: 0; background: none; color: var(--color-ink); font: inherit; font-size: var(--text-meta); text-align: left; text-decoration: underline; text-underline-offset: 0.25em; cursor: pointer; }
	.experience-open[hidden] { display: none; }
	.experience-open::after { content: ""; position: absolute; inset: 0; }
	.experience-open svg { width: 18px; height: 18px; flex: none; }
	.experience-open:focus-visible { outline: none; }
	.experience-open:focus-visible::after { outline: 2px solid var(--color-ink); outline-offset: 3px; }
	.experience-section[data-sheet-ready] .experience-disclosure { display: none; }
	.experience-disclosure { min-width: 0; }
	.experience-disclosure > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 44px; padding-block: 0.5rem; font-size: var(--text-meta); cursor: pointer; list-style: none; }
	.experience-disclosure > summary::-webkit-details-marker { display: none; }
	.experience-disclosure > summary svg { width: 20px; height: 20px; flex: none; }
	.experience-disclosure[open] .disclosure-plus { display: none; }
	.experience-disclosure[data-expanded-layout] > summary { display: none; }
	.experience-body { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: start; gap: 1.5rem; }
	.experience-image-wrap { min-width: 0; }
	.experience-image { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--color-border); }
	.experience-list { margin: 0; padding: 0; list-style: none; }
	.experience-list li { display: grid; gap: 0.35rem; padding-block: 0.8rem; border-top: 1px solid var(--color-border); font-size: 0.875rem; line-height: 1.65; }
	.experience-list strong { font-family: var(--font-ui); font-size: 0.875rem; font-weight: 600; line-height: 1.45; }
	.experience-list span { color: var(--color-muted); }
	.experience-list li:first-child { padding-top: 0; border-top: 0; }
	.ministry-intro { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 1.5rem; margin-bottom: 1.25rem; }
	.ministry-photo { min-width: 0; margin: 0; overflow: hidden; background: #eeece5; }
	/* The source cutout has transparent sides; the frame brings the building forward. */
	.ministry-photo .church-image { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 48% 50%; transform: scale(1.3); }
	.church-experience .experience-heading { padding: 0; }
	.church-experience .experience-heading h2 { font-size: clamp(1.75rem, 2.75vw, 2.15rem); }
	.church-experience .experience-meta { margin-top: 0.7rem; }
	.church-experience .experience-summary { max-width: 30ch; font-size: 0.9rem; }
	.church-experience .experience-body { display: block; }
	.church-experience .experience-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; padding-top: 0.85rem; border-top: 1px solid var(--color-border); }
	.church-experience .experience-list li { padding: 0; border: 0; }
	.experience-location { margin-top: 1rem; }
	.experience-address { max-width: 42ch; color: var(--color-muted); font-size: var(--text-meta); font-style: normal; line-height: 1.7; }
	.church-experience .experience-location { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 1rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border); }
	.organization-link { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; font-size: var(--text-meta); text-decoration: underline; text-underline-offset: 0.25em; }
	.service-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: end; gap: 0.75rem; max-width: 30rem; margin-top: 0.75rem; }
	.service-photos figure { min-width: 0; margin: 0; }
	.service-photos a { display: block; }
	.service-photos img { display: block; width: 100%; height: auto; }
	.service-photos figure:last-child img { max-width: 250px; }
	.service-photos figcaption { padding-top: 0.5rem; color: var(--color-muted); font-family: var(--font-label); font-size: var(--text-label); line-height: 1.6; }

	.experience-sheet { box-sizing: border-box; position: fixed; inset: 0 0 0 auto; width: min(calc(100% - 0.75rem), 32rem); max-width: none; height: 100dvh; max-height: 100dvh; margin: 0 0 0 auto; padding: 0; border: 0; border-left: 1px solid var(--color-border); border-radius: 0.65rem 0 0 0.65rem; background: var(--color-paper); color: var(--color-ink); overflow: hidden; box-shadow: -1rem 0 3rem #0002; }
	.experience-sheet[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
	.experience-sheet::backdrop { background: rgb(20 22 23 / 55%); }
	:global(html:has(.experience-sheet[open])) { overflow: hidden; }
	.sheet-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: max(0.375rem, env(safe-area-inset-top)) 1rem 0.375rem; border-bottom: 1px solid var(--color-border); }
	.sheet-toolbar p { margin: 0; color: var(--color-muted); font-family: var(--font-label); font-size: var(--text-label); letter-spacing: var(--tracking-label); text-transform: uppercase; }
	.sheet-close { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0.25rem; border: 0; background: none; color: inherit; font: inherit; font-size: var(--text-meta); cursor: pointer; }
	.sheet-close span { font-size: 1.5rem; line-height: 1; }
	.sheet-scroll { min-width: 0; min-height: 0; padding: 1.25rem 1rem max(1.25rem, env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; scroll-padding-block: 1rem; }
	.sheet-intro { padding-bottom: 1.25rem; }
	.sheet-organization { margin: 0 0 0.7rem; color: var(--color-accent); font-family: var(--font-label); font-size: var(--text-label); font-weight: 500; line-height: 1.7; letter-spacing: 0.04em; text-transform: uppercase; }
	.sheet-intro h2 { margin: 0; font-family: var(--font-display); font-size: 2rem; font-weight: 500; line-height: 1.1; letter-spacing: -0.025em; overflow-wrap: anywhere; }
	#experience-sheet-meta { margin: 0.7rem 0 0; color: var(--color-muted); font-family: var(--font-label); font-size: var(--text-label); line-height: 1.7; }
	.sheet-summary { margin: 0.75rem 0 0; font-size: var(--text-body); line-height: var(--line-body); }
	.sheet-content { display: grid; gap: 1.25rem; }
	.experience-sheet .experience-body { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
	.experience-sheet .experience-list { grid-template-columns: minmax(0, 1fr); }
	.experience-sheet .experience-list li { grid-template-columns: minmax(0, 1fr); gap: 0.35rem; padding-block: 0.8rem; border-top: 1px solid var(--color-border); font-size: var(--text-body); }
	.experience-sheet .experience-list li:first-child { border-top: 0; padding-top: 0; }
	.experience-sheet .experience-list strong { font-size: var(--text-body); }
	.experience-sheet :is(a, button):focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }

	@media (max-width: 760px) {
		.experience-page-heading { grid-template-columns: minmax(0, 1fr); gap: 1rem; padding: 1.25rem 1rem; }
		.experience-page-heading h1 { font-size: var(--mobile-title); }
		.experience-page-summary { font-size: var(--mobile-body); }
		.experience-kicker { margin-bottom: 0.65rem; }
		.experience-contents { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 0.75rem; }
		.experience-contents a { grid-template-columns: minmax(0, 1fr) auto; column-gap: 0.25rem; font-size: 0.72rem; }
		.experience-contents a span:first-child { display: none; }
		.experience-section { display: block; padding-block: 1.5rem; }
		.experience-record { display: flex; flex-direction: row; align-items: center; gap: 0.5rem; margin-bottom: 0.85rem; padding: 0; }
		.record-number { width: auto; height: auto; border: 0; }
		.record-type { font-size: var(--text-label); letter-spacing: var(--tracking-label); }
		.ministry-intro { grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-bottom: 0; }
		.experience-heading { padding-bottom: 0; }
		.experience-heading h2 { font-size: 1.85rem; }
		.experience-heading h2 br { display: none; }
		.church-experience .experience-heading h2 { font-size: 1.85rem; }
		.experience-meta { display: grid; gap: 0.25rem; margin-top: 0.65rem; }
		.experience-summary, .church-experience .experience-summary { max-width: 52ch; font-size: var(--mobile-body); }
		.experience-disclosure { margin-top: 0.75rem; }
		.experience-disclosure[open] > summary { margin-bottom: 0.75rem; }
		.experience-body { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
		.church-experience .experience-list { grid-template-columns: minmax(0, 1fr); gap: 0; }
		.church-experience .experience-list li { padding-block: 0.75rem; border-bottom: 1px solid var(--color-border); }
		.experience-image { aspect-ratio: 16 / 9; }
	}
	@media (max-width: 360px) {
		.experience-contents { grid-template-columns: minmax(0, 1fr); gap: 0; }
		.experience-contents a { grid-template-columns: 1.25rem minmax(0, 1fr) auto; font-size: var(--text-meta); }
		.experience-contents a span:first-child { display: inline; }
	}
</style>

<script>
	let disposeExperience: (() => void) | undefined;

	document.addEventListener('astro:page-load', () => {
		disposeExperience?.();
		const sheet = document.querySelector<HTMLDialogElement>('#experience-sheet');
		if (!sheet || typeof sheet.showModal !== 'function') return;
		const sections = document.querySelectorAll<HTMLElement>('.experience-section');
		const scroll = sheet.querySelector<HTMLElement>('.sheet-scroll')!;
		const content = sheet.querySelector<HTMLElement>('.sheet-content')!;
		const closeButton = sheet.querySelector<HTMLButtonElement>('.sheet-close')!;
		const phoneLayout = window.matchMedia('(max-width: 760px)');
		const controller = new AbortController();
		const { signal } = controller;
		let active: { section: HTMLElement; body: HTMLElement; home: HTMLDetailsElement; first: Element | null; photo?: HTMLElement } | null = null;
		let closeVersion = 0;

		const restoreContent = () => {
			if (!active) return;
			active.photo?.remove();
			if (active.first) active.body.prepend(active.first);
			active.home.append(active.body);
			active = null;
		};
		const closeSheet = (immediate = false) => {
			const section = active?.section;
			const version = ++closeVersion;
			if (sheet.open) sheet.close();
			if (section?.isConnected) {
				const focusTarget = phoneLayout.matches ? section.querySelector<HTMLElement>('.experience-open') : section.querySelector<HTMLElement>('h2');
				if (focusTarget) {
					if (!phoneLayout.matches) focusTarget.tabIndex = -1;
					focusTarget.focus({ preventScroll: true });
				}
			}
			if (immediate) { restoreContent(); return; }
			// Preserve the real content through the exit; rapid reopening invalidates this cleanup.
			Promise.allSettled(sheet.getAnimations().map(animation => animation.finished)).then(() => {
				if (version === closeVersion && !sheet.open) restoreContent();
			});
		};
		sections.forEach(section => {
			const trigger = section.querySelector<HTMLButtonElement>('.experience-open')!;
			trigger.addEventListener('click', () => {
				if (!phoneLayout.matches || sheet.open) return;
				++closeVersion;
				restoreContent();
				const home = section.querySelector<HTMLDetailsElement>('.experience-disclosure')!;
				const body = home.querySelector<HTMLElement>('.experience-body')!;
				active = { section, body, home, first: body.firstElementChild };
				// Keep the preview in place while its image is also shown in the reading panel.
				const photo = section.querySelector('.ministry-photo')?.cloneNode(true) as HTMLElement | undefined;
				if (photo) {
					active.photo = photo;
				}
				const responsibilities = body.querySelector<HTMLElement>(':scope > .experience-details, :scope > .experience-list');
				if (responsibilities) body.prepend(responsibilities);
				sheet.querySelector<HTMLElement>('#experience-sheet-title')!.textContent = section.querySelector('h2')!.textContent;
				sheet.querySelector<HTMLElement>('.sheet-organization')!.textContent = section.querySelector('.experience-meta span:first-child')!.textContent;
				const dates = section.querySelector('.experience-meta span + span')?.textContent ?? '';
				const sheetMeta = sheet.querySelector<HTMLElement>('#experience-sheet-meta')!;
				sheetMeta.textContent = dates;
				sheetMeta.hidden = !dates;
				sheet.querySelector<HTMLElement>('.sheet-summary')!.textContent = section.querySelector('.experience-summary')!.textContent;
				if (photo) content.append(photo);
				content.append(body);
				sheet.showModal();
				scroll.scrollTop = 0;
			}, { signal });
		});
		closeButton.addEventListener('click', () => closeSheet(), { signal });
		sheet.addEventListener('cancel', event => { event.preventDefault(); closeSheet(); }, { signal });
		let backdropPressed = false;
		sheet.addEventListener('close', () => { backdropPressed = false; }, { signal });
		sheet.addEventListener('pointercancel', () => { backdropPressed = false; }, { signal });
		sheet.addEventListener('pointerdown', event => { backdropPressed = event.target === sheet; }, { signal });
		sheet.addEventListener('click', event => {
			const bounds = sheet.getBoundingClientRect();
			if (backdropPressed && event.target === sheet && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) closeSheet();
			backdropPressed = false;
		}, { signal });

		const setLayout = () => {
			if (!phoneLayout.matches && active) closeSheet(true);
			sections.forEach(section => {
				const details = section.querySelector<HTMLDetailsElement>('.experience-disclosure')!;
				details.open = !phoneLayout.matches;
				details.toggleAttribute('data-expanded-layout', !phoneLayout.matches);
				section.toggleAttribute('data-sheet-ready', phoneLayout.matches);
				section.querySelector<HTMLButtonElement>('.experience-open')!.hidden = !phoneLayout.matches;
			});
		};
		setLayout();
		phoneLayout.addEventListener('change', setLayout, { signal });
		document.addEventListener('astro:before-preparation', () => closeSheet(true), { signal });
		disposeExperience = () => { closeSheet(true); controller.abort(); };
	});
</script>
