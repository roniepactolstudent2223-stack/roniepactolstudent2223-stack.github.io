</style>

<script>
	let removeLayoutListener: (() => void) | undefined;
	document.addEventListener('astro:page-load', () => {
	removeLayoutListener?.();
	const background = document.querySelector<HTMLDetailsElement>('.background-details');
	const phoneLayout = window.matchMedia('(max-width: 640px)');
	let userToggledBackground = false;
	background?.querySelector('summary')?.addEventListener('click', () => { userToggledBackground = true; });
	const setBackgroundLayout = () => { if (background && !userToggledBackground) background.open = !phoneLayout.matches; };
	setBackgroundLayout();
	phoneLayout.addEventListener('change', setBackgroundLayout);
	removeLayoutListener = () => phoneLayout.removeEventListener('change', setBackgroundLayout);
	});
</script>
