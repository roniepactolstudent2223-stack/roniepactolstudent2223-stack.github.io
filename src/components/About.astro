	.about-details { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--color-ink); }
	.background-details { min-width: 0; }
	.background-details summary, .about-details h3 { display: flex; align-items: center; justify-content: space-between; min-height: 44px; margin: 0 0 0.75rem; font-family: var(--font-ui); font-size: 1rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.5; }
	.background-details summary { cursor: pointer; list-style: none; }
	.background-details summary::-webkit-details-marker { display: none; }
	.background-details summary span { color: var(--color-muted); font: 400 1.2rem var(--font-ui); }
