---
import { Image } from 'astro:assets';
import dashboard from '../../public/images/ProjectAttendanceDashbaord.png';
import { churchAttendance as project } from '../content/projects/church-attendance';
import { writtenProjects } from '../content/projects/written-projects';
const contributions = writtenProjects.filter(item => item.experienceUrl);
---

<section class="selected-work" aria-labelledby="selected-work-title">
	<header class="work-heading">
		<div><p class="section-label">Selected work</p><h2 id="selected-work-title">From check-in to closing.</h2></div>
		<a class="text-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
	</header>
	<article class="work-feature" aria-labelledby="home-project-title">
		<figure class="work-plate">
		<a class="work-preview" href="/projects/church-attendance/" aria-label="Read the Church Attendance and Management System case study">
			<Image src={dashboard} alt={project.screenshots[0].alt} widths={[480, 800, 1200]} sizes="(max-width: 640px) calc(100vw - 2rem), 540px" format="webp" loading="lazy" />
		</a>
		<figcaption><span>Interface / 01</span>Administration dashboard</figcaption>
		</figure>
		<div class="work-copy">
			<p class="eyebrow">Church software</p>
			<h3 id="home-project-title"><a href="/projects/church-attendance/">{project.title}</a></h3>
			<p>{project.summary}</p>
			<dl class="work-facts"><div><dt>For</dt><dd>{project.organization}</dd></div><div><dt>My role</dt><dd>{project.role}</dd></div><div><dt>Built with</dt><dd>Laravel · Vue.js · MySQL</dd></div></dl>
			<a class="text-link" href="/projects/church-attendance/">Read case study <span aria-hidden="true">↗</span></a>
		</div>
	</article>
	<div class="work-contributions">
		{contributions.map(item => <a class="contribution" href={`/projects/${item.slug}/`}>
			<p class="work-context"><span>Work contribution</span>{item.organization}</p>
			<h3>{item.title}<span aria-hidden="true">↗</span></h3>
			<p>{item.summary}</p>
		</a>)}
	</div>
</section>

<style>
	.selected-work { padding-block: 2rem; border-bottom: 1px solid var(--color-ink); }
	.work-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.5rem; }
	h2 { margin: 0; font-size: 1.85rem; line-height: 1.15; }
	.work-feature { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; gap: 1.5rem; }
	.work-plate { min-width: 0; margin: 0; padding: 0.5rem; border: 1px solid var(--color-border); background: var(--color-tint); }
	.work-preview { display: block; border: 1px solid var(--color-border); background: var(--color-paper); }
	.work-preview img { display: block; width: 100%; height: auto; }
	.work-plate figcaption { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin-top: 0.65rem; color: var(--color-muted); font-size: var(--text-meta); }
	.work-plate figcaption span { font-family: var(--font-label); font-size: var(--text-label); text-transform: uppercase; letter-spacing: var(--tracking-label); }
	.work-copy { min-width: 0; }
	.work-copy h3 { margin: 0.5rem 0 0.65rem; font-family: var(--font-display); font-weight: 500; font-size: 1.65rem; letter-spacing: -0.025em; line-height: 1.15; }
	.work-copy h3 a:hover { text-decoration: underline; text-underline-offset: 0.15em; }
	.work-copy > p:not(.eyebrow) { margin: 0 0 0.75rem; font-size: var(--text-body); line-height: var(--line-body); }
	.work-copy > p.eyebrow { margin: 0 0 0.5rem; font-size: var(--text-label); line-height: 1.6; }
	.work-facts { display: grid; gap: 0.55rem; margin: 1rem 0 0.5rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border); }
	.work-facts > div { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr); gap: 0.5rem; }
	.work-facts dt { color: var(--color-muted); font: 500 var(--text-label)/1.7 var(--font-label); letter-spacing: var(--tracking-label); text-transform: uppercase; }
	.work-facts dd { margin: 0; font-size: var(--text-meta); line-height: 1.6; }
	.work-context { display: grid; gap: 0.25rem; margin: 0; color: var(--color-muted); font-size: var(--text-meta); line-height: 1.6; }
	.work-context span { font: 500 var(--text-label)/1.6 var(--font-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-olive); }
	.work-contributions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
	.contribution { display: block; min-width: 0; padding-top: 1rem; border-top: 1px solid var(--color-border); }
	.contribution h3 { display: flex; align-items: start; gap: 1rem; margin: 0.65rem 0 0.5rem; font-size: 1.15rem; line-height: 1.3; }
	.contribution h3 span { margin-left: auto; font-family: system-ui, sans-serif; flex: none; }
	.contribution > p:last-child { max-width: 52ch; margin: 0; color: var(--color-muted); font-size: 0.85rem; line-height: 1.7; }
	.contribution:hover h3, .contribution:focus-visible h3 { text-decoration: underline; text-underline-offset: 0.2em; }
	@media (max-width: 760px) {
		.selected-work { padding-block: 1.5rem; }
		h2 { font-size: 1.6rem; }
		.work-feature { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
		.work-contributions { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
		.work-copy > p:not(.eyebrow), .contribution > p:last-child { font-size: var(--mobile-body); }
	}
</style>
